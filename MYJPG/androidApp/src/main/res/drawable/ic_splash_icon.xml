<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 applies its own mask to this starting-window icon. Use the centered MYJPG mark
     with generous inset so the logo is neither cropped nor visually oversized. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="36dp"
    android:insetTop="36dp"
    android:insetRight="36dp"
    android:insetBottom="36dp">
    <bitmap
        android:antialias="true"
        android:gravity="center"
        android:src="@drawable/myjpg_launcher_mark" />
</inset>
