# MYJPG Environment Variables (No secrets committed)
# Google Maps Platform API Key (used by Express backend proxies and Maps JavaScript API)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
# Optional Cloud Map ID (defaults to DEMO_MAP_ID when unset)
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Gemini AI API Key (server-side only)
GEMINI_API_KEY=
