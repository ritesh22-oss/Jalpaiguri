rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'r36728659@gmail.com' ||
        request.auth.token.email == 'riteshganguly0911@gmail.com' ||
        request.auth.token.email == 'r11746667@gmail.com' ||
        request.auth.token.email == 'admin.civic@jalpaiguri.gov.in' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Workers Directory
    match /workers/{workerId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // Civic Reports
    match /civic_reports/{reportId} {
      allow read: if true;
      allow create: if true; // Allows citizens to submit reports
      allow update: if isSignedIn() || isAdmin(); // Upvotes, status updates
      allow delete: if isAdmin();
    }

    // Local Alerts
    match /local_alerts/{alertId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update: if true; // Confirm count increments
      allow delete: if isAdmin();
    }

    // Blood Donors
    match /blood_donors/{donorId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // Blood Requests
    match /blood_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // Jobs
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn() || true;
      allow update, delete: if isSignedIn() || isAdmin();
    }

    // Rentals
    match /rentals/{rentalId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn() || isAdmin();
    }

    // Lost & Found
    match /lost_found/{itemId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn() || isAdmin();
    }

    // Service Requests
    match /service_requests/{requestId} {
      allow read, write: if true;
    }

    // Chat Messages
    match /chats/{recipientId}/messages/{messageId} {
      allow read, write: if true;
    }

    // Admin Verifications
    match /admin_verifications/{verificationId} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isAdmin() || isSignedIn();
    }

    // Local Shops (Strict owner separation + Admin moderation)
    match /shops/{shopId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // Shop Products (Only owner of product/shop or Admin can edit/delete)
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // Citizen Shopping Lists
    match /shopping_lists/{listId} {
      allow read, write: if isSignedIn() && (request.auth.uid == listId || (resource != null && resource.data.userId == request.auth.uid) || request.resource.data.userId == request.auth.uid);
    }

    // Shop Inquiries (Analytics tracking)
    match /shop_inquiries/{inquiryId} {
      allow read: if isSignedIn();
      allow create: if true;
    }
  }
}
